{
  "name": "nft-mint-tracker-bot",
  "version": "0.1.0",
  "description": "Telegram bot for tracking NFT mints, gas prices, portfolio, reminders, and auto-mint. Inspired by @dnftminttracker_bot.",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "snipe": "ts-node src/cli/snipe.ts",
    "typecheck": "tsc --noEmit"
  },
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "dotenv": "^16.4.5",
    "ethers": "^6.16.0",
    "grammy": "^1.30.0"
  },
  "devDependencies": {
    "@types/node": "^20.14.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.5.4"
  }
}
