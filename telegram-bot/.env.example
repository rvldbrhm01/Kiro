# =============================================================================
# Kiro Telegram Bot — Konfigurasi
# Salin file ini: cp .env.example .env
# Lalu isi semua nilai yang diperlukan.
# JANGAN commit file .env ke git!
# =============================================================================

# -----------------------------------------------------------------------------
# WAJIB DIISI
# -----------------------------------------------------------------------------

# Token bot Telegram — dapatkan dari @BotFather dengan /newbot
TELEGRAM_BOT_TOKEN=isi_token_telegram_bot_kamu

# API key Anthropic — dapatkan dari https://console.anthropic.com/
ANTHROPIC_API_KEY=isi_anthropic_api_key_kamu

# Telegram user ID kamu (hanya user ini yang bisa pakai bot).
# Cara cari ID kamu: chat ke @userinfobot di Telegram.
# Untuk beberapa user: pisahkan dengan koma, misal 123456789,987654321
ALLOWED_USER_IDS=isi_telegram_user_id_kamu

# -----------------------------------------------------------------------------
# GITHUB (wajib untuk fitur GitHub)
# -----------------------------------------------------------------------------

# Personal Access Token GitHub — buat di:
# https://github.com/settings/tokens/new
# Scope yang diperlukan: repo (full), issues:write
GITHUB_TOKEN=isi_github_token_kamu

# Repo default (dipakai bila tidak ada argumen owner/repo)
GITHUB_OWNER=isi_username_github_kamu
GITHUB_REPO=isi_nama_repo_kamu

# -----------------------------------------------------------------------------
# AWS (wajib untuk fitur triage & duplicate detection via AWS Bedrock)
# -----------------------------------------------------------------------------

AWS_ACCESS_KEY_ID=isi_aws_access_key_id
AWS_SECRET_ACCESS_KEY=isi_aws_secret_access_key
AWS_REGION=us-east-1

# -----------------------------------------------------------------------------
# OPSIONAL — nilai default sudah cukup untuk mulai
# -----------------------------------------------------------------------------

# Model Claude yang dipakai
CLAUDE_MODEL=claude-opus-4-7

# Jumlah token output maksimal per balasan
CLAUDE_MAX_TOKENS=4096

# Iterasi tool-use maksimal sebelum menyerah
MAX_TOOL_ITERATIONS=10

# Jumlah pesan riwayat maksimal yang disimpan per user
MAX_HISTORY_MESSAGES=30

# Root workspace untuk tools baca/tulis kode
# Default: direktori induk dari telegram-bot/ (yaitu /projects/sandbox/)
# WORKSPACE_ROOT=/path/ke/workspace/kamu
