# =============================================================================
# Telegram bot
# =============================================================================
# Token from @BotFather
BOT_TOKEN=your_telegram_bot_token_here

# =============================================================================
# Optional: NFT data providers (used by /portfolio, /trending, etc.)
# =============================================================================
ETHERSCAN_API_KEY=
ALCHEMY_API_KEY=
RESERVOIR_API_KEY=

# Default chain: ethereum | polygon | base | arbitrum
DEFAULT_CHAIN=ethereum

# =============================================================================
# OpenSea SeaDrop FCFS auto-minter (used by /automint snipe and `npm run snipe`)
# =============================================================================
# RPC endpoints (Alchemy / Infura / public). Required for the chains you use.
ETH_RPC_URL=
BASE_RPC_URL=

# OpenSea SeaDrop 1.0 contract address. Defaults below match the canonical
# deployment; override only if the collection uses a custom drop contract.
ETH_SEADROP_ADDRESS=0x00005EA00Ac477B1030CE78506496e8C2dE24bf5
BASE_SEADROP_ADDRESS=0x00005EA00Ac477B1030CE78506496e8C2dE24bf5

# >>> SECURITY WARNING <<<
# Private key used to sign mint transactions. Use a DEDICATED HOT WALLET that
# only holds the funds you are willing to spend on mints + gas. NEVER paste
# the private key of your main wallet here. NEVER commit the .env file.
# Format: 0x-prefixed 64 hex chars.
MINTER_PRIVATE_KEY=
